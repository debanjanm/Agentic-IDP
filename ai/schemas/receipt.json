    },
    "transaction_time": {
      "type": [
        "string",
        "null"
      ],
      "description": "HH:MM, 24-hour"
    },
    "currency": {
      "type": [
        "string",
        "null"
      ],
      "description": "ISO 4217 code"
    },
    "subtotal": {
      "type": [
        "number",
        "null"
      ]
    },
    "tax_amount": {
      "type": [
        "number",
        "null"
      ]
    },
    "tip_amount": {
      "type": [
        "number",
        "null"
      ]
    },
    "total_amount": {
