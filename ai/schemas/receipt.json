            "type": [
              "string",
              "null"
            ]
          },
          "quantity": {
            "type": [
              "number",
              "null"
            ]
          },
          "price": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "quantity",
          "price"
        ]
      }
    }
  },
  "required": [
    "merchant_name",
    "transaction_date",
    "transaction_time",
    "currency",
    "subtotal",
    "tax_amount",
    "tip_amount",
    "total_amount",
