{
  "title": "Bank Statement",
  "description": "A periodic account statement from a bank or financial institution.",
  "x-checks": [
    "opening_balance + total_deposits - total_withdrawals = closing_balance",
    "statement_period_start <= statement_period_end"
  ],
  "type": "object",
  "properties": {
    "bank_name": { "type": ["string", "null"], "x-entity": { "type": "Bank", "key": "primary_name" } },
    "account_holder": { "type": ["string", "null"], "x-entity": { "type": "Person", "key": "primary_name" } },
    "account_number": { "type": ["string", "null"], "description": "as printed, including masking",
                         "x-entity": { "type": "Person", "key": "account_number", "strong": true } },
    "statement_period_start": { "type": ["string", "null"], "description": "ISO 8601, YYYY-MM-DD" },
    "statement_period_end": { "type": ["string", "null"], "description": "ISO 8601, YYYY-MM-DD" },
    "currency": { "type": ["string", "null"], "description": "ISO 4217 code" },
    "opening_balance": { "type": ["number", "null"] },
    "closing_balance": { "type": ["number", "null"] },
    "total_deposits": { "type": ["number", "null"] },
    "total_withdrawals": { "type": ["number", "null"] }
  },
  "required": ["bank_name", "account_holder", "account_number", "statement_period_start",
               "statement_period_end", "currency", "opening_balance", "closing_balance",
               "total_deposits", "total_withdrawals"]
}
